# Electron Desktop App Configuration
# Copy this to .env and fill in your values

# API Server
# For local development with PostgreSQL running on localhost
DATABASE_URL=postgresql://user:password@localhost:5432/novossh

# For production with remote database
# DATABASE_URL=postgresql://user:password@db.example.com:5432/novossh

# Authentication
JWT_SECRET=your-jwt-secret-key-change-this

# Stripe (optional - only needed for billing features)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# License (optional - for proprietary deployments)
NOVOSSH_LICENSE_KEY=NOVO-XXXX-XXXX-XXXX-XXXX

# SSL/TLS (optional - for production)
SSL_CERT_PATH=/path/to/server.crt
SSL_KEY_PATH=/path/to/server.key

# Node environment
NODE_ENV=development
