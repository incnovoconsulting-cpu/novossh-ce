# NovoSSH Production Environment Configuration
# Copy this file to .env and fill in production values
# CRITICAL: Never commit actual values to git

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port (default: 8787)
PORT=8787

# Server hostname/IP (default: 0.0.0.0)
HOST=0.0.0.0

# Node environment (production, staging, development)
NODE_ENV=production

# Service version (should match package.json)
SERVICE_VERSION=0.1.0

# ============================================================================
# DATABASE CONNECTION
# ============================================================================

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
# With connection pooling: postgres://user:password@host:port/database?sslmode=require&pool_size=20
DATABASE_URL=postgres://user:password@localhost:5432/novossh

# Database connection pool configuration
DB_POOL_SIZE=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_REAP_INTERVAL=1000
DB_POOL_CONNECTION_TIMEOUT=10000

# SSL/TLS for database connections
DB_SSL_MODE=require
DB_SSL_CERT_PATH=/path/to/cert.pem
DB_SSL_KEY_PATH=/path/to/key.pem
DB_SSL_CA_PATH=/path/to/ca.pem

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT secret key (generate with: openssl rand -base64 32)
# CRITICAL: Generate strong random value, never use default
JWT_SECRET=your-very-long-random-secret-key-min-32-characters

# JWT expiration time
JWT_EXPIRES_IN=24h

# Password hashing cost factor (10-14 recommended, higher = slower but more secure)
BCRYPT_COST=12

# Session timeout in milliseconds (default: 24 hours)
SESSION_TIMEOUT=86400000

# ============================================================================
# CORS & ORIGIN CONFIGURATION
# ============================================================================

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://novossh.example.com,https://app.novossh.example.com

# Allow credentials in CORS requests
ALLOW_CREDENTIALS=true

# ============================================================================
# RATE LIMITING
# ============================================================================

# Global rate limit: requests per window
RATE_LIMIT_REQUESTS=1000

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW=900000

# Auth endpoint rate limit: requests per window
AUTH_RATE_LIMIT_REQUESTS=5

# Auth endpoint rate limit window in milliseconds
AUTH_RATE_LIMIT_WINDOW=900000

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# Enable detailed request/response logging
REQUEST_LOGGING=true

# Enable performance metrics collection
METRICS_ENABLED=true

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# Enable health checks
HEALTH_CHECK_ENABLED=true

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL=30000

# Critical memory threshold (percentage)
MEMORY_THRESHOLD_CRITICAL=90

# Degraded memory threshold (percentage)
MEMORY_THRESHOLD_DEGRADED=75

# Database response time threshold for degraded status (milliseconds)
DB_RESPONSE_TIME_DEGRADED=1000

# Database response time threshold for unhealthy status (milliseconds)
DB_RESPONSE_TIME_UNHEALTHY=5000

# ============================================================================
# GRACEFUL SHUTDOWN
# ============================================================================

# Grace period for in-flight requests (milliseconds)
SHUTDOWN_GRACE_PERIOD=30000

# Force shutdown timeout (milliseconds)
SHUTDOWN_FORCE_TIMEOUT=60000

# Maximum in-flight requests to track
MAX_IN_FLIGHT_REQUESTS=10000

# ============================================================================
# SSH BRIDGE CONFIGURATION
# ============================================================================

# SSH connection timeout in milliseconds
SSH_TIMEOUT=30000

# SSH keepalive interval in milliseconds
SSH_KEEPALIVE_INTERVAL=30000

# Maximum SSH connections per user
MAX_SSH_CONNECTIONS_PER_USER=10

# Maximum concurrent SSH operations
MAX_CONCURRENT_SSH_OPS=100

# ============================================================================
# TAILSCALE CONFIGURATION (if using Tailscale)
# ============================================================================

# Tailscale IP address (if deployed via Tailscale)
TAILSCALE_IP_ADDRESS=100.x.x.x

# Tailscale auth key for automated login
TAILSCALE_AUTH_KEY=tskey-your-auth-key-here

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================

# Enable automated database backups
BACKUP_ENABLED=true

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_STORAGE_PATH=/mnt/backups/novossh

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Enable debug mode (verbose logging)
DEBUG=false

# Enable profiling (performance analysis)
ENABLE_PROFILING=false

# Request ID header name for tracing
REQUEST_ID_HEADER=X-Request-ID

# Trust proxy setting (for X-Forwarded-For headers)
TRUST_PROXY=1

# Maximum request body size
MAX_REQUEST_SIZE=2mb

# WebSocket frame size limit
WS_MAX_FRAME_SIZE=1mb

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API server URL for frontend (used when deployed separately from backend)
# Leave empty for same-host API, or set to backend URL for Cloudflare Pages deployment
VITE_API_URL=http://203.0.113.10:8787

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable offline sync functionality
FEATURE_OFFLINE_SYNC=true

# Enable P2P sync functionality
FEATURE_P2P_SYNC=true

# Enable session recording
FEATURE_SESSION_RECORDING=true

# Enable port forwarding
FEATURE_PORT_FORWARDING=true

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================

# Sentry error tracking (if using Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# DataDog monitoring (if using DataDog)
DATADOG_API_KEY=your-datadog-api-key

# New Relic monitoring (if using New Relic)
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

# Custom error tracking endpoint
ERROR_TRACKING_ENDPOINT=https://errors.example.com/api/errors

# ============================================================================
# LICENSE (Required for production)
# ============================================================================

# NovoSSH license key (contact sales@novoconsultinginc.org to obtain)
# Format: NOVO-XXXX-XXXX-XXXX-XXXX
NOVOSSH_LICENSE_KEY=NOVO-XXXX-XXXX-XXXX-XXXX

# License secret for key verification (internal use)
LICENSE_SECRET=CHANGE_ME_RANDOM_SECRET

# ============================================================================
# STRIPE BILLING (Required for paid plans)
# ============================================================================

# Stripe secret key (use sk_test_ for development, sk_live_ for production)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price IDs for subscription plans (create in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Stripe webhook signing secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URL for Stripe redirect flows
FRONTEND_URL=https://novossh-github.pages.dev

# ============================================================================
# EMAIL (Optional - for verification and notifications)
# ============================================================================

# SMTP server for sending emails (e.g., Gmail, SendGrid, AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
