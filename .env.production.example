# ═══════════════════════════════════════════════════════════════════════════════
# NovoSSH Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env.production and fill in all values before deployment.
# Run: ./scripts/deploy/env-setup.sh validate

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://novossh:CHANGE_ME@localhost:5432/novossh

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=https://novossh.example.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ─── SSL (optional, use if not behind reverse proxy) ──────────────────────────
# SSL_CERT_PATH=/etc/ssl/certs/novossh.crt
# SSL_KEY_PATH=/etc/ssl/private/novossh.key

# ─── Headscale (Tailscale coordination server) ────────────────────────────────
# HEADSCALE_URL=http://localhost:8080
# HEADSCALE_API_KEY=your-headscale-api-key

# ─── Error Tracking (optional) ────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ─── Deployment Notifications (optional) ──────────────────────────────────────
# Slack, Discord, or generic webhook URL
# DEPLOY_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ─── Backup (optional) ───────────────────────────────────────────────────────
# S3 bucket for automated database backups
# BACKUP_S3_BUCKET=novossh-backups
# Generate with: openssl rand -hex 32
# BACKUP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ─── Frontend Configuration ───────────────────────────────────────────────────
# API server URL for frontend (required for Cloudflare Pages deployment)
# Set to backend API URL when frontend and backend are on different domains
VITE_API_URL=http://203.0.113.10:8787

# ─── PostHog Analytics ───────────────────────────────────────────────────────
# PostHog API key (get from PostHog Settings > Project)
VITE_POSTHOG_KEY=phc_your_posthog_project_key
# PostHog host URL (use your self-hosted instance or cloud URL)
VITE_POSTHOG_HOST=http://127.0.0.1:8200
