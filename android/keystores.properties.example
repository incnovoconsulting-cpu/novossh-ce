# Android Signing Configuration for Play Store Release
#
# SETUP INSTRUCTIONS:
# 1. Generate a new keystore (if you don't have one):
#    keytool -genkey -v -keystore novossh.keystore -alias novossh-key \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy this file to keystores.properties:
#    cp keystores.properties.example keystores.properties
#
# 3. Fill in the values below with your keystore details
#    (NEVER commit keystores.properties to git - it's in .gitignore)
#
# IMPORTANT: Keep your keystore and passwords secure!
# - Store keystore file safely (not in repo)
# - Use a strong password (20+ chars with mixed case, numbers, symbols)
# - Backup the keystore and password securely
# - The same keystore MUST be used for all future app updates on Play Store

# Path to the keystore file (absolute or relative to android/ directory)
storeFile=path/to/novossh.keystore

# Password for the keystore
storePassword=your-keystore-password

# Alias for the key inside the keystore
keyAlias=novossh-key

# Password for the specific key (can be same as storePassword)
keyPassword=your-key-password
